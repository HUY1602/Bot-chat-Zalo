# ==============================================================
# CẤU HÌNH ZALO GEMINI BOT (VERCEL 24/7)
# ==============================================================

# 1. Token của Bot Zalo (Lấy từ Zalo Bot Creator / Bot Platform)
# Ví dụ: 123456789:AaBbCcDdEeFfGgHh
ZALO_BOT_TOKEN=

# 2. Khóa Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 3. Model Gemini sử dụng (Mặc định: gemini-2.5-flash hoặc gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Tra cứu Google (đăng ký tại https://serpapi.com/).
# Khi thiếu key/hết lượt, bot thử DuckDuckGo; dịch vụ dự phòng có thể chặn truy cập.
SERPAPI_API_KEY=
# Dự phòng khi SerpAPI hết lượt: Gemini có Google Search và trích dẫn nguồn.
# Dùng GEMINI_API_KEY ở trên; chịu hạn mức/chi phí riêng của Google.
GEMINI_SEARCH_ENABLED=true
GEMINI_SEARCH_MODEL=gemini-3.5-flash-lite

# OpenAI-compatible provider, được ưu tiên trước Gemini.
# Nếu câu trả lời dài/bị ngắt, bot thử yêu cầu FreeModel trả lời gọn trước khi dự phòng Gemini.
# Nếu FreeModel lỗi hoặc timeout, bot tự động chuyển sang Gemini.
FREEMODEL_API_KEY=
FREEMODEL_BASE_URL=https://freemodel.in/v1
FREEMODEL_MODEL=gpt-6-luna

# 4. Bắt buộc: khóa riêng cho webhook, quản trị và cron. Dùng chuỗi ngẫu nhiên khác nhau.
# Đăng nhập dashboard bằng tên admin và mật khẩu ADMIN_SECRET.
WEBHOOK_SECRET=
ADMIN_SECRET=
# Đặt cùng giá trị trong GitHub Actions repository secret CRON_SECRET.
CRON_SECRET=

# 5. (Tùy chọn) Địa chỉ Base API của Zalo Bot Platform (mặc định không cần đổi)
ZALO_API_BASE=https://bot-api.zaloplatforms.com/bot/

# 6. Bộ nhớ hội thoại và danh sách nhóm nhận điểm tin (Upstash Redis)
# Lấy miễn phí tại: https://console.upstash.com/ (Tạo Redis Database -> Tab .env)
# BẮT BUỘC để điểm tin buổi sáng hoạt động ổn định trên Vercel Serverless.
# Nếu để trống, dữ liệu chỉ nằm tạm trong RAM và có thể mất giữa các lần chạy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 7. Ảnh đại diện của Bot (Tự động gửi khi thành viên yêu cầu xem mặt / xem hình / xem ảnh)
# Hỗ trợ cực kỳ tiện lợi:
# - CÁCH 1 (KHUYÊN DÙNG): Dán link cả THƯ MỤC Google Drive (Bật quyền "Bất kỳ ai có đường liên kết đều có thể xem")
#   Bot sẽ tự động quét TẤT CẢ ảnh trong thư mục và tự động RANDOM đổi ảnh mỗi lần được hỏi (KHÔNG CẦN API KEY):
#   BOT_AVATAR_URL=https://drive.google.com/drive/folders/1ZXEhzbLRLU1giKKRJkjm8N04cO_JoYE2
# - CÁCH 2: Dán 1 hoặc nhiều link ảnh lẻ (cách nhau bởi dấu phẩy):
#   BOT_AVATAR_URL=https://drive.google.com/file/d/ID1/view, https://drive.google.com/file/d/ID2/view
# - CÁCH 3: Biến riêng cho thư mục:
#   GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/ID_THU_MUC
BOT_AVATAR_URL=

# 8. (Tùy chọn) Tính cách/Nhiệm vụ riêng của Bot trong nhóm Zalo
# SYSTEM_INSTRUCTION="Bạn là trợ lý giải đáp thắc mắc chuyên về..."

# 9. Thành phố dùng trong điểm tin thời tiết buổi sáng (mặc định: hanoi)
# Hỗ trợ tất cả tỉnh thành Việt Nam & quốc tế (có thể đổi riêng theo từng nhóm qua /diemtin city <tên>)
DEFAULT_WEATHER_CITY=hanoi

# 10. (Tùy chọn) Danh sách Zalo User ID được quyền Admin trong nhóm (cách nhau bởi dấu phẩy)
# Dùng /id trong chat để xem User ID. Khi cấu hình, chỉ Admin mới được dùng /reset.
ADMIN_ZALO_IDS=

# 11. (Tùy chọn) Số lượng tin nhắn lịch sử gần nhất gửi cho AI mỗi lượt chat thường (mặc định: 30)
CHAT_HISTORY_LIMIT=30

