# ==============================================================
# CẤU HÌNH ZALO GEMINI BOT (VERCEL 24/7)
# ==============================================================

# 1. Token của Bot Zalo (Lấy từ Zalo Bot Creator / Bot Platform)
# Ví dụ: 123456789:AaBbCcDdEeFfGgHh
ZALO_BOT_TOKEN=

# 2. Khóa Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 3. Model Gemini sử dụng (Mặc định: gemini-2.5-flash hoặc gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 4. (Tùy chọn) Khóa bí mật bảo mật Webhook (Tránh request giả mạo)
# Có thể để trống hoặc đặt 1 chuỗi ngẫu nhiên bất kỳ
WEBHOOK_SECRET=

# 5. (Tùy chọn) Địa chỉ Base API của Zalo Bot Platform (mặc định không cần đổi)
ZALO_API_BASE=https://bot-api.zaloplatforms.com/bot/

# 6. Trí nhớ hội thoại đa lượt (Multi-turn Chat Memory - Upstash Redis Miễn Phí)
# Lấy miễn phí tại: https://console.upstash.com/ (Tạo Redis Database -> Tab .env)
# Nếu để trống: Hệ thống tự động dùng bộ nhớ RAM (In-Memory Fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 7. Ảnh đại diện của Bot (Tự động gửi khi thành viên yêu cầu xem mặt / xem hình / xem ảnh)
# Hỗ trợ cực kỳ tiện lợi:
# - CÁCH 1 (KHUYÊN DÙNG): Dán link cả THƯ MỤC Google Drive (Bật quyền "Bất kỳ ai có đường liên kết đều có thể xem")
#   Bot sẽ tự động quét TẤT CẢ ảnh trong thư mục và tự động RANDOM đổi ảnh mỗi lần được hỏi (KHÔNG CẦN API KEY):
#   BOT_AVATAR_URL=https://drive.google.com/drive/folders/1ZXEhzbLRLU1giKKRJkjm8N04cO_JoYE2
# - CÁCH 2: Dán 1 hoặc nhiều link ảnh lẻ (cách nhau bởi dấu phẩy):
#   BOT_AVATAR_URL=https://drive.google.com/file/d/ID1/view, https://drive.google.com/file/d/ID2/view
# - CÁCH 3: Biến riêng cho thư mục:
#   GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/ID_THU_MUC
BOT_AVATAR_URL=

# 8. (Tùy chọn) Tính cách/Nhiệm vụ riêng của Bot trong nhóm Zalo
# SYSTEM_INSTRUCTION="Bạn là trợ lý giải đáp thắc mắc chuyên về..."

